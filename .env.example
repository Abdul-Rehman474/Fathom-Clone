# ---------------------------------------------------------------------------
# Fathom Clone — environment (architecture.md §10)
# Copy to .env.local and fill in. With MOCK_PROVIDERS=true the AI/meeting
# providers below (Deepgram, Anthropic, Recall, Google, Zoom) are not required;
# only the Supabase and site vars are needed to run the app end to end.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the client

# Mock mode — return realistic fixture data instead of calling live providers
MOCK_PROVIDERS=true

# AI providers (optional when MOCK_PROVIDERS=true)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_WEBHOOK_SECRET=

# Meeting bot (optional; deferred to a later prompt)
RECALL_API_KEY=
RECALL_REGION_BASE_URL=             # e.g. https://us-west-2.recall.ai
RECALL_WEBHOOK_SECRET=

# Meeting-link OAuth (optional; deferred to a later prompt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 32-byte base64 key for encrypting stored OAuth tokens (AES-GCM)
TOKEN_ENC_KEY=
