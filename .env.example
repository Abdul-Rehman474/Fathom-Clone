# ---------------------------------------------------------------------------
# Fathom Clone — environment (architecture.md §10)
# Copy to .env.local and fill in. With MOCK_PROVIDERS=true the AI/meeting
# providers below (Deepgram, Anthropic, Recall, Google, Zoom) are not required;
# only the Supabase and site vars are needed to run the app end to end.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the client

# Mock mode — return realistic fixture data instead of calling live providers.
# When true, Groq and Deepgram are NOT called even if keys are set. Set to false
# to use real Deepgram/Groq (Deepgram also needs a public callback URL — deploy,
# or run a tunnel locally and point NEXT_PUBLIC_SITE_URL at it).
MOCK_PROVIDERS=true

# AI providers (optional when MOCK_PROVIDERS=true)
# LLM = Groq (OpenAI-compatible). Summaries, Ask and the help bot use these.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile     # summaries + Ask
GROQ_FAST_MODEL=llama-3.1-8b-instant   # titles + FAQ bot
# Transcription = Deepgram (nova-3)
DEEPGRAM_API_KEY=
DEEPGRAM_WEBHOOK_SECRET=

# Meeting bot (Recall.ai). Live when MOCK_PROVIDERS=false and the key is set.
# Webhook: in the Recall dashboard point bot status events at
#   ${NEXT_PUBLIC_SITE_URL}/api/webhooks/recall  and paste its signing secret
# (whsec_…) below. Without a public URL, status polling syncs from Recall.
RECALL_API_KEY=
RECALL_REGION_BASE_URL=             # e.g. https://us-west-2.recall.ai
RECALL_WEBHOOK_SECRET=              # whsec_…

# Meeting-link OAuth (optional; deferred to a later prompt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 32-byte base64 key for encrypting stored OAuth tokens (AES-GCM)
TOKEN_ENC_KEY=
